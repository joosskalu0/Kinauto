# ==========================================
# KINIMMO BACKEND - CONFIGURATION HOSTINGER & LOCAL
# ==========================================

# Port d'écoute du serveur Node.js (ex: 5000 en local, ou variable PORT fournie par Hostinger)
PORT=5000

# Informations de connexion à la base de données MySQL
# Sur Hostinger : localhost (ou adresse IP/Host du serveur MySQL fourni dans hPanel)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_kinimmo
DB_PASSWORD=VotreMotDePasseMySQLSecurise123!
DB_NAME=u123456789_kinimmo_db

# Clé secrète pour la signature des JSON Web Tokens (JWT)
# Générez une chaîne aléatoire longue et complexe
JWT_SECRET=kinimmo_super_secret_jwt_key_kinshasa_2026_987654321
JWT_EXPIRES_IN=7d

# URL autorisée pour le CORS (URL du frontend déployé ou en local)
# Ex Hostinger : https://kinimmo.votre-domaine.com
FRONTEND_URL=http://localhost:3000
