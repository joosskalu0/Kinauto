# ==========================================
# CONGOCAR BACKEND - CONFIGURATION MYSQL & SERVEUR
# ==========================================

# Port d'écoute du serveur Node.js (ex: 5000 en local, ou variable PORT d'hébergement)
PORT=5000

# Informations de connexion à la base de données MySQL
# Sur Hostinger / cPanel / VPS : localhost ou adresse IP fournie
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_congocar
DB_PASSWORD=VotreMotDePasseMySQLSecurise123!
DB_NAME=congocar_db

# Clé secrète pour la signature des JSON Web Tokens (JWT)
JWT_SECRET=congocar_super_secret_jwt_key_kinshasa_2026_987654321
JWT_EXPIRES_IN=7d

# URL autorisée pour le CORS (URL du frontend déployé ou en local)
FRONTEND_URL=http://localhost:3000

